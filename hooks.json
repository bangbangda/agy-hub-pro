{
  "agy-hud-pro": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./collector.mjs --event SessionStart",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./collector.mjs --event PreInvocation",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./collector.mjs --event Stop",
        "timeout": 5
      }
    ]
  }
}
